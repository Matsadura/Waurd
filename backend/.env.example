# Application
ENVIRONMENT=development
PROJECT_NAME=FastAPI MySQL Service
API_V1_STR=/api/v1

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=app_user
DB_PASSWORD=app_password
DB_NAME=app_db

# Docker Compose/MySQL container variables
DB_USER_PASSWORD=app_password
DB_ROOT_PASSWORD=root_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=20
REDIS_URL=redis://localhost:6379/0

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
GOOGLE_FRONTEND_REDIRECT_URI=http://localhost:3000
GOOGLE_OAUTH_STATE_TTL_SECONDS=600

# Two-factor authentication (emailed codes)
TWO_FACTOR_COOKIE_NAME=two_factor_token
TWO_FACTOR_CODE_TTL_SECONDS=600
TWO_FACTOR_MAX_ATTEMPTS=5
TWO_FACTOR_RESEND_COOLDOWN_SECONDS=60

# Outgoing email (Gmail). MAIL_PASSWORD is a 16-character Google app password:
# https://myaccount.google.com/apppasswords
MAIL_USERNAME=your-address@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM_NAME=Waurd
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_STARTTLS=true
MAIL_SSL_TLS=false

# Cookie and session security
SESSION_COOKIE_NAME=session_id
CSRF_COOKIE_NAME=csrf_token
COOKIE_SECURE=false
SESSION_TTL_SECONDS=604800
SESSION_COOKIE_SAMESITE=lax

# CORS; use a JSON array because this is a list setting
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]